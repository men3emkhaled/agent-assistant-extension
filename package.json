{
  "name": "agent-assistant",
  "displayName": "Agent Assistant",
  "description": "The definitive Expert Persona & Quota Management system for AI Agents. Empower your workflow with deep skill injection and real-time resource tracking.",
  "version": "1.3.0",
  "icon": "logo_square.png",
  "publisher": "Men3emkhaled",
  "repository": {
    "type": "git",
    "url": "https://github.com/men3emkhaled/agent-assistant-extension.git"
  },
  "bugs": {
    "url": "https://github.com/men3emkhaled/agent-assistant-extension/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent-assistant",
    "agentassistant",
    "agent assistant",
    "ai-agent-assistant",
    "expert-agent",
    "agent-skills",
    "agent-persona",
    "agent-expert",
    "agent-assistant-ai",
    "agent-assistant-extension",
    "antigravity",
    "antigravity-ide",
    "antigravity-hub",
    "claude-3-5-sonnet",
    "gpt-4o",
    "gemini-1-5-pro",
    "cursor-rules",
    "copilot-instructions",
    "expert-personas",
    "rtl-support",
    "arabic-rtl",
    "men3em"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agent-assistant.addAccount",
    "onView:agent-assistant.accountsView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agent-assistant.openPanel",
        "title": "Open Agent Assistant Dashboard",
        "category": "Agent Assistant"
      },
      {
        "command": "agent-assistant.refreshAccounts",
        "title": "Refresh Accounts",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-assistant.refreshBalances",
        "title": "Refresh Model Balances",
        "category": "Agent Assistant",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-assistant.addAccount",
        "title": "Add Account",
        "icon": "$(add)"
      },
      {
        "command": "agent-assistant.searchAccounts",
        "title": "Search Accounts",
        "icon": "$(search)"
      },
      {
        "command": "agent-assistant.clearSearch",
        "title": "Clear Search",
        "icon": "$(close)"
      },
      {
        "command": "agent-assistant.treeSwitch",
        "title": "Switch to Account",
        "category": "Agent Assistant",
        "icon": "$(zap)"
      },
      {
        "command": "agent-assistant.treeDelete",
        "title": "Remove Account",
        "category": "Agent Assistant",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.switchAccount",
        "title": "Switch Active Account",
        "category": "Agent Assistant",
        "icon": "$(zap)"
      },
      {
        "command": "agent-assistant.searchSkills",
        "title": "Search Skills",
        "icon": "$(search)"
      },
      {
        "command": "agent-assistant.clearSkillsSearch",
        "title": "Clear Search",
        "icon": "$(close)"
      },
      {
        "command": "agent-assistant.toggleAllSkills",
        "title": "Toggle All Skills",
        "icon": "$(check-all)"
      },
      {
        "command": "agent-assistant.openMarketplace",
        "title": "Skill Marketplace",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agent-assistant.createCustomSkill",
        "title": "Create Custom Skill",
        "icon": "$(add)"
      },
      {
        "command": "agent-assistant.deleteCustomSkill",
        "title": "Delete Custom Skill",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.addProjectWorkspace",
        "title": "Add Project Workspace Path",
        "icon": "$(add)"
      },
      {
        "command": "agent-assistant.deleteProjectSkill",
        "title": "Delete Project Skill",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.deleteProjectFolder",
        "title": "Remove Project Folder",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.autoScanRecommendSkills",
        "title": "Auto Scan & Recommend Skills",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agent-assistant.deleteSkill",
        "title": "Uninstall Skill",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.moveSkillFolder",
        "title": "Move to Folder...",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agent-assistant.deleteFolder",
        "title": "Delete Folder",
        "icon": "$(trash)"
      },
      {
        "command": "agent-assistant.renameFolder",
        "title": "Rename Folder",
        "icon": "$(edit)"
      },
      {
        "command": "agent-assistant.createFolder",
        "title": "Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "agent-assistant.toggleCategorySkills",
        "title": "Toggle Whole Folder",
        "icon": "$(run-all)"
      },
      {
        "command": "agent-assistant.detectTechStack",
        "title": "Detect Workspace Tech-Stack",
        "category": "Agent Assistant"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-assistant",
          "title": "Agent Assistant",
          "icon": "resources/icons/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "agent-assistant": [
        {
          "id": "agent-assistant.accountsView",
          "name": "Accounts",
          "icon": "resources/icons/sidebar-icon.svg"
        },
        {
          "id": "agent-assistant.skillsView",
          "name": "Expert Skills",
          "icon": "resources/icons/sidebar-icon.svg"
        },
        {
          "id": "agent-assistant.customSkillsView",
          "name": "Custom Skills",
          "icon": "resources/icons/sidebar-icon.svg"
        },
        {
          "id": "agent-assistant.projectSkillsView",
          "name": "Project Skills",
          "icon": "resources/icons/sidebar-icon.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "agent-assistant.switchAccount",
          "when": "viewItem == inactiveAccount",
          "group": "inline"
        },
        {
          "command": "agent-assistant.treeDelete",
          "when": "viewItem == activeAccount || viewItem == inactiveAccount",
          "group": "inline"
        },
        {
          "command": "agent-assistant.deleteCustomSkill",
          "when": "viewItem == customSkillItem",
          "group": "inline"
        },
        {
          "command": "agent-assistant.deleteProjectSkill",
          "when": "viewItem == projectSkillItem",
          "group": "inline"
        },
        {
          "command": "agent-assistant.deleteProjectFolder",
          "when": "viewItem == projectFolder",
          "group": "inline"
        },
        {
          "command": "agent-assistant.toggleCategorySkills",
          "when": "viewItem == categoryItem",
          "group": "inline"
        },
        {
          "command": "agent-assistant.deleteSkill",
          "when": "viewItem == skillItem",
          "group": "inline"
        },
        {
          "command": "agent-assistant.moveSkillFolder",
          "when": "viewItem == skillItem"
        },
        {
          "command": "agent-assistant.deleteFolder",
          "when": "viewItem == categoryItem",
          "group": "inline"
        },
        {
          "command": "agent-assistant.renameFolder",
          "when": "viewItem == categoryItem",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "agent-assistant.searchAccounts",
          "when": "view == agent-assistant.accountsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.clearSearch",
          "when": "view == agent-assistant.accountsView && agent-assistant.isSearching",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.refreshAccounts",
          "when": "view == agent-assistant.accountsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.addAccount",
          "when": "view == agent-assistant.accountsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.createFolder",
          "when": "view == agent-assistant.skillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.searchSkills",
          "when": "view == agent-assistant.skillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.clearSkillsSearch",
          "when": "view == agent-assistant.skillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.toggleAllSkills",
          "when": "view == agent-assistant.skillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.openMarketplace",
          "when": "view == agent-assistant.skillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.createCustomSkill",
          "when": "view == agent-assistant.customSkillsView",
          "group": "navigation"
        },
        {
          "command": "agent-assistant.autoScanRecommendSkills",
          "when": "view == agent-assistant.projectSkillsView",
          "group": "navigation@1"
        },
        {
          "command": "agent-assistant.addProjectWorkspace",
          "when": "view == agent-assistant.projectSkillsView",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agent-assistant.openPanel",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "agent-assistant.switchAccount",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "agent-assistant.addAccount",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "agent-assistant.refreshBalances",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "configuration": {
      "title": "Agent Assistant",
      "properties": {
        "antigravityAccounts.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ar"
          ],
          "enumDescriptions": [
            "Auto (Detect from Editor)",
            "English",
            "العربية"
          ],
          "description": "Display language for the extension UI"
        },
        "antigravityAccounts.refreshIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "description": "Interval in minutes for automatic balance refresh"
        },
        "antigravityAccounts.lowCreditThreshold": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Credit threshold for low balance warning"
        },
        "antigravityAccounts.enableAutoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch to another account when the active account's credit is depleted"
        },
        "antigravityAccounts.skillsMarketplaceUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/men3emkhaled/antigravity-accounts-extension/main/skills.json",
          "description": "URL to the raw JSON registry of the Skill Marketplace on GitHub"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:sql.js --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:sql.js --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx -y @vscode/vsce package --allow-package-all-secrets",
    "package:win": "npx -y @vscode/vsce package --target win32-x64 --allow-package-all-secrets",
    "package:mac": "npx -y @vscode/vsce package --target darwin-arm64 --target darwin-x64 --allow-package-all-secrets",
    "package:linux": "npx -y @vscode/vsce package --target linux-x64 --allow-package-all-secrets",
    "package:all": "npm run package:win && npm run package:mac && npm run package:linux"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
